# Sao chép file này thành .env (hoặc .env.local) rồi chỉnh giá trị cho phù hợp.
# Vite chỉ đọc các biến có tiền tố VITE_.

# Địa chỉ gốc của REST API Back-end (Spring Boot) — xem Mục X kế hoạch triển khai.
# Khi chạy Back-end cục bộ theo cấu hình mặc định trong kế hoạch:
VITE_API_BASE_URL=http://localhost:8080/api/v1

# true  = Front-end dùng dữ liệu mock nội bộ (mặc định — dùng khi Back-end chưa sẵn sàng)
# false = Front-end gọi API thật tới VITE_API_BASE_URL ở trên
VITE_USE_MOCK=true
